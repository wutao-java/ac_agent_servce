# MySQL 容器首次启动时创建的数据库名称。
MYSQL_DATABASE=agent_demo
# MySQL 服务映射到宿主机的端口。
MYSQL_PORT=3306
# MySQL root 用户密码，使用前必须替换为强密码。
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
# 电商后端服务映射到宿主机的端口。
ECOMMERCE_BACKEND_PORT=8081
# 电商前端服务映射到宿主机的端口。
ECOMMERCE_FRONTEND_PORT=5174
# 电商后端访问 Agent 服务的基础地址；host.docker.internal 指向 Docker 宿主机。
AGENT_SERVICE_BASE_URL=http://host.docker.internal:8000
# 电商后端与 Agent 服务双向调用时使用的共享认证令牌，使用前必须替换。
AGENT_SERVICE_AUTH_TOKEN=replace-with-a-service-token

# Agent Center 访问电商后端 API 的基础地址。
ECOMMERCE_BACKEND_BASE_URL=http://127.0.0.1:8081
# Agent Center 调用模型服务时使用的 API Key。
AGENT_CENTER_AI_API_KEY=
# LangGraph Checkpointer 使用的可选 PostgreSQL 连接地址；留空时会话记忆仅保存在当前进程。
AGENT_CENTER_POSTGRES_URL=
